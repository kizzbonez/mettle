# Mettle configuration. Copy to .env, or run `npm run init:env` to generate
# one with random secrets. Never commit .env.

# --- Where the site is reached -------------------------------------------
# The origin people type into the browser. Used for links in emails and to
# decide whether cookies are marked Secure (https origins only).
PUBLIC_ORIGIN=http://localhost:4310
# Host ports. Both are bound to 127.0.0.1 only.
WEB_PORT=4310
MAILPIT_PORT=4325

# --- Secrets (generated by `npm run init:env`) ---------------------------
POSTGRES_PASSWORD=
# Signs access tokens. At least 32 characters.
JWT_SECRET=
# 32 random bytes, base64. Encrypts two-factor secrets at rest.
DATA_KEY=
# Shared secret between the API and the sandbox runner.
RUNNER_TOKEN=

# --- Email ----------------------------------------------------------------
# The default sends to the bundled Mailpit inbox (http://localhost:4325),
# which only catches mail. Point these at a real SMTP server to deliver it.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mettle <noreply@mettle.local>

# --- Sandbox ----------------------------------------------------------------
# Submissions that may run at the same time.
RUNNER_MAX_CONCURRENCY=2
# OCI runtime for sandboxes. Leave empty for the Docker default, or set to
# `runsc` if gVisor is installed for a stronger boundary.
SANDBOX_RUNTIME=

# --- Content ----------------------------------------------------------------
# Load the curriculum in ./content into an empty database on first start.
SEED_CONTENT=true
