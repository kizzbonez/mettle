{
  "name": "mettle",
  "version": "1.5.0",
  "private": true,
  "description": "Mettle: competency exams and hands-on labs with sandboxed code execution.",
  "license": "MIT",
  "author": "Johndenver Contaoi",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init:env": "node scripts/init-env.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "npm run db:generate -w @mettle/api",
    "sandbox:build": "docker compose build sandbox-rust sandbox-python sandbox-bash sandbox-cpp sandbox-csharp sandbox-yaml",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "test:sandbox": "vitest run -c vitest.sandbox.config.ts",
    "content:verify": "tsx scripts/verify-content.ts",
    "content:try": "tsx scripts/try-lab.ts",
    "dev:services": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db runner mailpit",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:web": "npm run dev -w @mettle/web",
    "test:api": "vitest run -c vitest.api.config.ts",
    "docs:curriculum": "tsx scripts/build-curriculum-doc.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "e2e": "node e2e/tour.mjs",
    "screenshots": "node e2e/tour.mjs --shots"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
