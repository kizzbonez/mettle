{
  "name": "monitoring",
  "services": {
    "prometheus": {
      "image": "prom/prometheus:v3.5.0",
      "user": "65534:65534",
      "ports": [
        {"mode": "ingress", "host_ip": "127.0.0.1", "target": 9090, "published": "9090", "protocol": "tcp"}
      ],
      "networks": {"default": null}
    },
    "grafana": {
      "image": "grafana/grafana:12.1.1",
      "ports": [
        {"mode": "ingress", "host_ip": "0.0.0.0", "target": 3000, "published": "3000", "protocol": "tcp"}
      ],
      "networks": {"default": null}
    },
    "cadvisor": {
      "image": "gcr.io/cadvisor/cadvisor:v0.52.1",
      "privileged": true,
      "ports": [
        {"mode": "ingress", "host_ip": "::", "target": 8080, "published": "8081", "protocol": "tcp"}
      ],
      "volumes": [
        {"type": "bind", "source": "/", "target": "/rootfs", "read_only": true},
        {"type": "bind", "source": "/var/run", "target": "/var/run", "read_only": true}
      ],
      "networks": {"default": null}
    }
  },
  "networks": {"default": {"name": "monitoring_default"}}
}
